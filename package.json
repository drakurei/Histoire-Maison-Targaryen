{
  "name": "targaryen-chronicles",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Targārio Lentro Vestriarja. Musée numérique consacré à la Maison Targaryen, en haut valyrien, français et anglais.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "content": "node scripts/build-content.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src scripts tests",
    "test": "vitest run",
    "build": "npm run content && tsc -b --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "shots": "node tests/visual/shots.mjs",
    "audit:links": "node tests/functional/links.mjs",
    "build:pages": "npm run content && tsc -b --noEmit && vite build && node scripts/pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alegreya": "^5.3.0",
    "@fontsource-variable/grenze-gotisch": "^5.3.0",
    "@fontsource-variable/texturina": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.65.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
